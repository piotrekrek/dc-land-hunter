# Docker Compose settings. Copy to infra/.env (never commit it).
POSTGRES_USER=dclh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dclh
# Contact address in the User-Agent of every request to public data services (politeness rule).
DCLH_CONTACT_EMAIL=you@example.com
# ":80" locally. In production: the public domain (e.g. dclh.example.pl); Caddy then serves HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8080
DB_HOST_PORT=55432
# Set to 1 to serve the interactive API docs at /api/docs and the schema at /api/openapi.json (off by default).
DCLH_API_DOCS=0
# The public address users reach the app at, e.g. https://dclh.example (no trailing slash). Setting it switches on
# the Claude connector at <address>/mcp. Leave empty to keep it off. Must match SITE_ADDRESS (with https://).
DCLH_PUBLIC_URL=
