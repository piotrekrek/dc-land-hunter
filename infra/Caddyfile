# SITE_ADDRESS: ":80" for local use; the public domain in production (Caddy then gets HTTPS automatically).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Private tool: keep it out of search engines.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	handle /api/* {
		# Replace, do not append: a client-sent X-Forwarded-For must never reach the API.
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /tiles/* {
		reverse_proxy martin:3000
	}

	# Basemap (OpenFreeMap) via our own origin: the web app rewrites tiles.openfreemap.org URLs to /basemap/*.
	handle_path /basemap/* {
		reverse_proxy https://tiles.openfreemap.org {
			header_up Host tiles.openfreemap.org
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
