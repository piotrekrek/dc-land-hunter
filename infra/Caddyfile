# SITE_ADDRESS: ":80" for local use; the public domain in production (Caddy then gets HTTPS automatically).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Private tool: keep it out of search engines.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Tiles and basemap need a login. Each request asks the API whether the session cookie is valid
	# (GET /api/auth/me); a non-2xx answer is returned to the client as is.
	handle /tiles/* {
		forward_auth api:8000 {
			uri /api/auth/me
		}
		reverse_proxy martin:3000
	}

	# Basemap (OpenFreeMap) via our own origin: the web app rewrites tiles.openfreemap.org URLs to /basemap/*.
	handle_path /basemap/* {
		forward_auth api:8000 {
			uri /api/auth/me
		}
		reverse_proxy https://tiles.openfreemap.org {
			header_up Host tiles.openfreemap.org
		}
	}

	handle {
		root * /srv
		# A missing file under /assets/ is a 404, not the app's index.html (a broken script link would fail
		# with a confusing MIME error). Other paths fall back to index.html for client-side routes.
		@assets path /assets/*
		handle @assets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		try_files {path} /index.html
		file_server
	}
}
