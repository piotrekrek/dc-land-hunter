# Local development outside Docker (uv run ...). Copy to .env (never commit it).
# The database is the one from docker compose (exposed on 127.0.0.1:55432).
DATABASE_URL=postgresql+psycopg://dclh:dclh@localhost:55432/dclh
DCLH_CONTACT_EMAIL=you@example.com
# Optional: path to a Chromium binary for `dclh discover --capture-network`.
# DCLH_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
